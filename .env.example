NODE_ENV=development
PORT=4000
BASE_URL=http://localhost:4000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cocojojochem

JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Payments — Stripe (https://dashboard.stripe.com/apikeys)
# Not connected yet. Checkout is currently a disabled mockup; no charge is
# ever made until this is wired up (see TODO.md, "Payments (Stripe)").
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
# Used to verify incoming webhook signatures (stripe.webhooks.constructEvent)
# before trusting a payment_intent.succeeded/failed event — required before
# the /webhooks/stripe endpoint can safely handle real traffic.
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Shipping — Shippo (https://apps.goshippo.com/settings/api)
# Optional. Powers live shipment creation (OrdersService.createShipmentForOrder)
# and live tracking-checkpoint lookups. If unset, both gracefully no-op/fall
# back instead of crashing — nothing is faked.
# ---------------------------------------------------------------------------
SHIPPO_API_KEY=
# Used to verify incoming Shippo webhook signatures before trusting a tracking
# update — required before /webhooks/shippo can safely handle real traffic.
SHIPPO_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Shipping — ShipStation (https://ship.shipstation.com/settings/api-settings)
# Not connected yet — no order is ever actually pushed to ShipStation today.
# ---------------------------------------------------------------------------
SHIPSTATION_API_KEY=
SHIPSTATION_API_SECRET=

# ---------------------------------------------------------------------------
# Email — no EmailService exists yet at all (see TODO.md, "Email
# notifications"); nothing currently sends an email for anything (order
# confirmation, password reset, contact form, etc). These are placeholders
# for whichever provider(s) get chosen when that's built.
#
# The real cocojojo.com splits this across THREE providers: Resend for the
# contact form, Brevo for general transactional email (order confirmations),
# and MailerLite for the newsletter. Replicating that 3-provider split isn't
# necessary for us — picking just ONE provider for everything is simpler and
# recommended; both are listed below so the choice is documented either way.
# ---------------------------------------------------------------------------
# Brevo (https://app.brevo.com/settings/keys/api) — general transactional email.
BREVO_API_KEY=
# Resend (https://resend.com/api-keys) — what the real site uses specifically
# for its contact form; a simpler/cheaper option if you only need
# "send this one email" rather than Brevo's fuller marketing/automation suite.
RESEND_API_KEY=
