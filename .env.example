NODE_ENV=development
PORT=4000
BASE_URL=http://localhost:4000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cocojojochem

JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Payments — Stripe (https://dashboard.stripe.com/apikeys)
# Not connected yet. Checkout is currently a disabled mockup; no charge is
# ever made until this is wired up (see TODO.md, "Payments (Stripe)").
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
# Used to verify incoming webhook signatures (stripe.webhooks.constructEvent)
# before trusting a payment_intent.succeeded/failed event — required before
# the /webhooks/stripe endpoint can safely handle real traffic.
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Shipping — Shippo (https://apps.goshippo.com/settings/api)
#
# Shippo is the SOLE shipping provider. On payment success the backend creates
# a shipment, buys a label and records the tracking number it returns, then
# subscribes that number for tracking webhooks.
#
# Tokens are prefixed shippo_test_… or shippo_live_…. Test tokens buy free
# labels watermarked "SAMPLE - DO NOT MAIL" and DO generate tracking numbers,
# but tracking status never updates in test mode.
#
# Unset = every shipping call logs a warning and no-ops. Nothing is faked.
# ---------------------------------------------------------------------------
SHIPPO_API_KEY=

# Shippo can HMAC-sign webhooks (header HTTP_SHIPPO_AUTH_SIGNATURE, format
# "t=<ts>,v1=<sig>", HMAC-SHA256 over "{timestamp}.{raw_body}") but the shared
# secret is NOT self-service — you must request it from your Shippo account
# manager and provisioning takes up to 10 business days. Until then the
# /webhooks/shippo endpoint is unauthenticated; see webhooks.service.ts.
SHIPPO_WEBHOOK_SECRET=

# Warehouse ship-from address. Site settings (warehouseName, warehouseStreet,
# warehouseCity, warehouseState, warehouseZip, warehouseCountry,
# warehousePhone) take priority over these; if BOTH are unset the backend
# refuses to buy a label rather than printing a placeholder origin address.
SHIPPO_FROM_NAME=
SHIPPO_FROM_STREET1=
SHIPPO_FROM_CITY=
SHIPPO_FROM_STATE=
SHIPPO_FROM_ZIP=
SHIPPO_FROM_COUNTRY=US
SHIPPO_FROM_PHONE=
# REQUIRED. Shippo rejects a transaction outright with
# `Attribute "address_from.email" must not be empty` (verified live), and
# carriers require an origin phone. Admin > Settings "Sender Email" wins
# over this env var.
SHIPPO_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Shipping — ShipStation: DISABLED, kept for reference only.
#
# Replaced by Shippo. ShipStation's V2 API (which our key type is for) only
# creates a shipment RECORD — POST /v2/shipments returns a shipment_id and
# never a tracking number; buying the label is a separate POST /v2/labels call
# that was never implemented. Shippo does the whole flow in one pass.
#
# The module/service/DTOs are still in the tree and the call sites are
# commented, so this can be restored — see OrdersService.pushOrderToShipStation.
# ---------------------------------------------------------------------------
# SHIPSTATION_API_KEY=
# SHIPSTATION_API_SECRET=
# SHIPSTATION_API_URL=https://api.shipstation.com/v2

# ---------------------------------------------------------------------------
# Email — Resend (https://resend.com/api-keys) is the single provider for
# every transactional email: order confirmation + cancellation, shipping
# confirmation, password reset, and the internal quote/contact/new-order/
# refund-required notifications. All of them funnel through one method,
# EmailService.sendEmail.
#
# Unset here, EmailService no-ops with an explicit log line rather than
# pretending the mail went out.
#
# Resend requires the SENDING DOMAIN to be DNS-verified (SPF + DKIM) before
# it will accept mail from FROM_EMAIL. onboarding@resend.dev sends without
# any setup but delivers ONLY to your own Resend account address, so it is
# useful for a smoke test and nothing else.
#
# Previously Brevo (@getbrevo/brevo); sendEmailWithBrevo is kept commented
# out in email.service.ts for reference.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
